# Server
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/forge-fitness
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/forge-fitness
MONGO_URI=mongodb://127.0.0.1:27017/forge-fitness

# Secret used to sign admin JWTs — replace with a long random string
JWT_SECRET=replace_this_with_a_long_random_string

# How long an admin login token stays valid
JWT_EXPIRES_IN=7d

# The frontend origin allowed to call this API (Vite dev server default)
CLIENT_URL=http://localhost:5173

# Optional: credentials used by `npm run seed` to create the first admin.
# If left unset, defaults to admin@forgefitness.in / ChangeMe123!
SEED_ADMIN_EMAIL=admin@forgefitness.in
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional: SMTP settings for sending real "forgot password" emails.
# If left blank, reset links are printed to the backend console instead —
# handy for local development, but set these for production.
# Example using Gmail: create an "App Password" at
# https://myaccount.google.com/apppasswords and use it as EMAIL_PASS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Forge Fitness <no-reply@forgefitness.in>

